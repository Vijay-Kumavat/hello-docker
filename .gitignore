## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# DotCover
.idea/
*.dotCover

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet Packages
*.nupkg
# The packages folder can be ignored if it is not under source control
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Entity Framework
*.edmx.sql
*.edmx.diagram
*.edmx

# Others
*.dbmdl
*.bak
*.log
*.vspscc
*.vssscc
*.cache
*.pdb
*.mdb
*.svclog
*.scc

# Windows image file caches
Thumbs.db
ehthumbs.db

# Web config transforms
*.config

# Publish Web Output
*.Publish.xml

# Azure Web Apps
.scm/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotNetCore
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCopReport.xml

# TFS
$tf/

# JetBrains Rider
.idea/

# Node.js
node_modules/

# Yarn
.yarn/
.pnp.*

# Others
*.vs/

# ── Security: exclude files that may contain credentials ──────────────────────
# These files should never be committed. Use environment variables or a secret
# manager (Azure Key Vault, User Secrets) instead.
credentials.json
dist/credentials.json
appsettings.Production.json
appsettings.production.json
.env.local
.env.production
*.secrets.json
secrets.json
